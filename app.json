{
  "expo": {
    "name": "Gileo Medicals",
    "slug": "gileo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gileo-symbol.png",
    "scheme": "gileo",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/gileo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/gileo-symbol.png",
      "bundleIdentifier": "com.gileo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/gileo-symbol.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gileo.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/gileo-symbol.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/gileo-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
